{
  "name": "the-little-soldier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "game",
    "lab"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:unit:game": "npm run test --workspace=game",
    "test:unit:lab": "npm run test --workspace=lab",
    "test": "npx playwright test",
    "lint": "npm run lint --workspaces"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@playwright/test": "^1.58.2",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "knip": "^5.85.0",
    "playwright": "^1.58.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "knip": {
    "workspaces": {
      "game": {
        "entry": [
          "src/main.tsx"
        ],
        "ignore": []
      },
      "lab": {
        "entry": [
          "src/main.tsx"
        ],
        "ignore": []
      }
    },
    "ignore": [
      "tools/**",
      "battlefield-lab/**"
    ]
  }
}
